# Copy to agent/.env for local runs (never commit .env). In GitHub Actions use repository secrets.

# Gmail SMTP login. Use a 16-char App Password (Google Account -> Security -> 2-Step Verification -> App passwords).
# Accepted formats: the bare password, user@gmail.com:password, or {"email": "...", "app_password": "..."}
GMAIL_APP_PASSWORD=

# Pitch generation and lead qualification: set one of them (Anthropic is preferred when both are set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram: create a bot with @BotFather, then get your chat id (e.g. via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional and legacy: the webhook secret is derived from TELEGRAM_BOT_TOKEN, nothing to copy to Vercel.
# TELEGRAM_WEBHOOK_SECRET=

# Safety switch. Emails are only really sent when this is exactly "false".
DRY_RUN=true

# Super-admin of the Telegram bot: your numeric Telegram id (ask @userinfobot). Only this user gets /admin, /stats, /leads and the lead-card buttons.
# If empty, TELEGRAM_CHAT_ID is used. Keep the two equal so GitHub Actions reports reach the same person.
ADMIN_TELEGRAM_ID=

# Instagram comment -> Direct auto-reply (Vercel only, api/instagram.js). Webhook URL: https://<your-vercel-domain>/api/instagram
# IG_VERIFY_TOKEN: any string, the same one you type into the Meta app webhook settings.
# IG_APP_SECRET: Meta app -> Settings -> Basic -> App Secret (signature check). IG_ACCESS_TOKEN: token with instagram_manage_messages.
# IG_USER_ID: id of the Instagram professional account.
IG_VERIFY_TOKEN=
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_USER_ID=
