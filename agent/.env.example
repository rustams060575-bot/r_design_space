# Copy to agent/.env for local runs (never commit .env). In GitHub Actions use repository secrets.

# Gmail SMTP: a 16-char App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_APP_PASSWORD=

# Pitch generation: set one of them (Anthropic is preferred when both are set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram alerts: create a bot with @BotFather, then get your chat id (e.g. via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety switch. Emails are only really sent when this is exactly "false".
DRY_RUN=true
